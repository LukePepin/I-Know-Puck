# Copy this file to .env and fill in your values. .env is git-ignored.
#
# LEAGUE ID: the number after leagueId= in your ESPN league URL
#   https://fantasy.espn.com/hockey/league?leagueId=123456
ESPN_LEAGUE_ID=

# Private-league cookies. In a browser logged into ESPN:
#   DevTools (F12) -> Application -> Cookies -> https://fantasy.espn.com (or espn.com;
#   both cookies live on the shared .espn.com domain, so the values are identical)
#   copy ONLY the values of `espn_s2` and `SWID` (SWID includes the {curly braces}).
ESPN_S2=
ESPN_SWID=

# ESPN season id = the year the NHL season ENDS (2026-27 season -> 2027)
ESPN_SEASON=2027
